# AI SRE Copilot — local environment
COMPOSE_PROJECT_NAME=ai-sre-copilot

# Sample application
SAMPLE_APP_PORT=8080
SAMPLE_APP_LOG_LEVEL=INFO
SAMPLE_APP_SERVICE_NAME=sample-app
SAMPLE_APP_ENVIRONMENT=local

# OpenTelemetry (full collector in Phase 7)
OTEL_SERVICE_NAME=sample-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none

# Observability ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# Phase 2 — Incident Engine / Postgres
POSTGRES_USER=sre
POSTGRES_PASSWORD=sre
POSTGRES_DB=sre_incidents
POSTGRES_PORT=5432
INCIDENT_SERVICE_PORT=8000
INCIDENT_LOG_LEVEL=INFO
INCIDENT_ENVIRONMENT=local

# Phase 3 — Context Collection
CONTEXT_SERVICE_PORT=8020
CONTEXT_LOG_LEVEL=INFO
CONTEXT_ENVIRONMENT=local

# Phase 4 — AI Investigation
KNOWLEDGE_SERVICE_PORT=8030
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_ENVIRONMENT=local
INVESTIGATION_SERVICE_PORT=8031
INVESTIGATION_LOG_LEVEL=INFO
INVESTIGATION_ENVIRONMENT=local
OLLAMA_PORT=11434
# Measured via eval/run_llm_eval.py against the golden incident set:
# - llama3.2 (3b): 100% root-cause accuracy after the rca_synthesizer prompt
#   fix (see docs/eval.md), ~15-40s per call. Needs the longer timeout below.
# - llama3.2:1b: fast (~10s) and never times out, but scored 0% -- it is not
#   reliable at this task's structured-JSON + multi-field reasoning demands.
# Use 3b unless you have a strong reason not to; 1b is not a safe substitute.
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_ENABLED=true
PROMPT_VERSION=rca-v1

# AI infrastructure
REDIS_PORT=6379
MODEL_GATEWAY_PORT=8040
EMBEDDING_GATEWAY_PORT=8041
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 5 — Remediation
REMEDIATION_SERVICE_PORT=8032
REMEDIATION_LOG_LEVEL=INFO
REMEDIATION_ENVIRONMENT=local
EXECUTION_ENABLED=true
ALLOW_MUTATIONS=false
ALLOW_COMPOSE_RESTART=false

# Phase 6 — Executive Dashboard
EXECUTIVE_DASHBOARD_PORT=8050

# Phase 7 — Auth / OTel / secrets
AUTH_SERVICE_PORT=8060
AUTH_ENABLED=true
JWT_SECRET=change-me-phase7-local-secret-min-32-chars!!
JWT_ISSUER=ai-sre-copilot
INTERNAL_SERVICE_TOKEN=local-internal-service-token
AUTH_USERS=admin:admin123:admin,operator:operator123:operator,viewer:viewer123:viewer
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
JAEGER_UI_PORT=16686
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
